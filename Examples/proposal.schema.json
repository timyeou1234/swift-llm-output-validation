{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moment sample task proposal — structural contract only",
  "description": "Adapted sample contract, not the full Moment backend schema. Cross-field and product rules are implemented in Swift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "semanticType",
          "userLabel",
          "userConfirmedOrder",
          "view",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "family": {
            "enum": [
              "act",
              "create"
            ]
          },
          "semanticType": {
            "enum": [
              "action_checklist",
              "invitation_draft"
            ]
          },
          "userLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "userConfirmedOrder": {
            "type": "integer",
            "minimum": 0
          },
          "view": {
            "enum": [
              "form",
              "list",
              "checklist_timeline",
              "draft"
            ]
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "role",
                "label",
                "valueType",
                "required"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9._-]*$"
                },
                "role": {
                  "enum": [
                    "action_items",
                    "action_outcome",
                    "draft_audience",
                    "draft_body"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "valueType": {
                  "enum": [
                    "text",
                    "rich_text",
                    "ordered_items"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "candidateValue": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
